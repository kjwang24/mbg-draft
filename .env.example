# Resend API key, used as the SMTP password for nodemailer (api/contact.ts).
# Sign up at https://resend.com, verify a sending domain, and create an API key.
SMTP_PASS=

# Optional: override the "from" address once you've verified a domain with Resend.
# Until then, api/contact.ts falls back to Resend's shared sandbox sender.
SENDER_EMAIL=
